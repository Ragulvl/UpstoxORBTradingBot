# ============================================================
# Upstox ORB Trading Bot — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# ============================================================

# ── Upstox API Credentials ──────────────────────────────────
# Get from: https://upstox.com/developer/api-documentation/
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# Access token (refreshed daily after OAuth login)
UPSTOX_ACCESS_TOKEN=your_access_token_here

# Sandbox orders — use a separate sandbox API key/secret if applicable
UPSTOX_SANDBOX_API_KEY=your_sandbox_api_key_here
UPSTOX_SANDBOX_API_SECRET=your_sandbox_api_secret_here
UPSTOX_SANDBOX_ACCESS_TOKEN=your_sandbox_access_token_here

# ── Market Data (Production WebSocket) ──────────────────────
# Upstox v3 WebSocket for real-time market data
UPSTOX_MARKET_DATA_TOKEN=your_market_data_access_token_here
UPSTOX_WEBSOCKET_URL=wss://api-v2.upstox.com/feed/market-data-feed/v2

# ── Trading Parameters ──────────────────────────────────────
TRADING_CAPITAL=100000
DAILY_LOSS_LIMIT_PERCENT=2
MAX_TRADES_PER_DAY=2
RISK_PER_TRADE_PERCENT=2

# ── Instruments (comma-separated) ───────────────────────────
INSTRUMENTS=NIFTY,BANKNIFTY

# ── Optional Alerts ─────────────────────────────────────────
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK_URL=

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

